                  </a>
                </div>
              </div>
            </div>

            <!-- Right side - GitHub link -->
            <div class="flex items-center">
              <a href="https://github.com/leandroandrade/fastify-cjs-ui"
                 target="_blank"
                 rel="noopener noreferrer"
                 class="px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-primary dark:hover:text-primary hover:bg-gray-50 dark:hover:bg-gray-700 rounded-lg transition-all flex items-center gap-2">
